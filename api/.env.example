NODE_ENV=development
PORT=4000
MONGO_URI=mongodb://localhost:27017/inventory
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:3000

# Vercel only: shared secret for the scheduled-job endpoints (/cron/*).
# Vercel Cron sends it automatically as a Bearer token. Any long random string.
CRON_SECRET=
