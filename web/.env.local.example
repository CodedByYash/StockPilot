# Local dev: the browser talks to the API directly.
NEXT_PRIVATE_API_URL=http://localhost:4000

# Vercel: use the same-origin proxy instead (see next.config.ts), and point
# API_ORIGIN at the deployed API project, e.g.
#   NEXT_PRIVATE_API_URL=/api
#   API_ORIGIN=https://your-inventory-api.vercel.app
