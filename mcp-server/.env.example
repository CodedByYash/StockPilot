# Base URL of the running inventory API (see ../api)
API_BASE_URL=http://localhost:4000

# JWT for the MCP service account — see mcp-server/README.md for how to
# generate this. Never a real user's session token.
MCP_SERVICE_TOKEN=

# Vercel (remote HTTP mode) only: bearer token clients must send to /mcp.
# Any long random string. Not needed for local stdio use.
MCP_AUTH_TOKEN=
